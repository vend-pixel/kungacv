# Backend API base URL (falls back to the hosted API when unset)
NEXT_PUBLIC_API_URL=https://kungacv-backend.onrender.com

# Google Tag Manager container id (GTM-XXXXXXX). Leave unset to disable analytics.
NEXT_PUBLIC_GTM_ID=

# Pro pass pricing shown at checkout (MWK) and pass duration in days
NEXT_PUBLIC_PRO_PRICE_MWK=5000
NEXT_PUBLIC_PRO_PASS_DAYS=30
