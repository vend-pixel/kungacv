NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
# Render injects PORT at runtime; SERVER_PORT remains the local fallback.
PORT=3000
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=kungacv
MONGO_AUTH_SOURCE=admin
MONGO_USERNAME=
MONGO_PASSWORD=
JWT_SECRET=your_secret_key_change_me
# MONGODB_URI / MONGODB_USERNAME / MONGODB_PASSWORD are also accepted as
# fallbacks when the MONGO_* names above are unset (see config/app.config.ts).

# PayChangu payments (Phase 3)
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_PRO_PRICE_MWK=5000
PAYCHANGU_PRO_PASS_DAYS=30
CLIENT_URL=http://localhost:3001
CORS_ORIGINS=

# Cloudinary — required for admin template preview uploads
# (POST /admin/templates/:uid/preview). Optional for local boot.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kungacv/templates

# Admin bootstrap. Required to enable POST /admin/signup; send the same value
# in the X-Admin-Signup-Token header. No admin account exists until this is set
# and the endpoint is called with your chosen password.
ADMIN_SIGNUP_TOKEN=
